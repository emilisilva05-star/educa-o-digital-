<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agro Forte - A Força que Move o Brasil</title>
    <style>
        /* --- VARIÁVEIS E ESTILOS GLOBAIS --- */
        :root {
            --verde-escuro: #1b4332;
            --verde-medio: #2d6a4f;
            --verde-claro: #52b788;
            --verde-fundo: #d8f3dc;
            --amarelo-ouro: #e9c46a;
            --marrom-terra: #582f0e;
            --cinza-fundo: #f8f9fa;
            --texto-dark: #212529;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--cinza-fundo);
            color: var(--texto-dark);
            line-height: 1.6;
        }

        /* --- CABEÇALHO / HERO SECTION --- */
        header {
            background: linear-gradient(rgba(27, 67, 50, 0.85), rgba(88, 47, 14, 0.7)), 
                        url('https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=1200&q=80') center/cover no-repeat;
            color: #ffffff;
            text-align: center;
            padding: 5rem 1.5rem;
        }

        header h1 {
            font-size: 2.8rem;
            margin-bottom: 1rem;
            color: var(--amarelo-ouro);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        header p {
            font-size: 1.25rem;
            max-width: 800px;
            margin: 0 auto;
            opacity: 0.95;
        }

        /* --- CONTAINER PRINCIPAL --- */
        .container {
            max-width: 1100px;
            margin: -3rem auto 3rem auto;
            padding: 0 1.5rem;
            position: relative;
            z-index: 10;
        }

